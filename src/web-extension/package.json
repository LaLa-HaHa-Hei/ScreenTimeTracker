    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "file-type": "^22.0.1"
  }
}